<subsection xml:id="subsec_identifiers">
  <title>Keywords and Identifiers</title>
  <p>
	The Java language contains 50 predefined <term>keywords</term>
	(    <xref ref="tab_keywords">Table</xref>).
	These are words that have special meaning in the language and whose use is reserved for special purposes.
  </p>
  <table xml:id="tab_keywords">
    <title>Java keywords. Those with * are not used.</title>
  <tabular>
     <row>
  <cell>
        <c>abstract</c>
  </cell>
  <cell>
        <c>continue</c>
  </cell>
  <cell>
